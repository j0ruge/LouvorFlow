generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

// ─── Multi-Tenant ─────────────────────────────────────────────────

enum TenantStatus {
  active
  inactive
  system
}

/// Representa uma igreja/comunidade no sistema multi-tenant.
model Tenant {
  id         String       @id @default(uuid()) @db.Uuid
  name       String       @db.VarChar(255)
  status     TenantStatus @default(active)
  created_at DateTime     @default(now()) @db.Timestamp(6)
  updated_at DateTime     @updatedAt @db.Timestamp(6)

  tenant_users       TenantUsers[]
  artistas           Artistas[]
  musicas            Musicas[]
  tonalidades        Tonalidades[]
  funcoes            Funcoes[]
  categorias         Categorias[]
  tipos_eventos      Tipos_Eventos[]
  eventos            Eventos[]
  artistas_musicas   Artistas_Musicas[]
  musicas_funcoes    Musicas_Funcoes[]
  musicas_categorias Musicas_Categorias[]
  eventos_musicas    Eventos_Musicas[]
  eventos_users      Eventos_Users[]
  eventos_users_funcoes Eventos_Users_Funcoes[]
  users_funcoes      Users_Funcoes[]
  users_roles        UsersRoles[]
  users_permissions  UsersPermissions[]

  @@map("tenants")
}

/// Associação N:N entre usuários e tenants (igrejas).
model TenantUsers {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
  tenant     Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user       Users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, user_id])
  @@index([tenant_id])
  @@index([user_id])
  @@map("tenant_users")
}

// ─── Domain Entities ──────────────────────────────────────────────

model Artistas {
  id         String             @id @default(uuid()) @db.Uuid
  nome       String
  tenant_id  String             @db.Uuid
  created_at DateTime           @default(now()) @db.Timestamp(6)
  updated_at DateTime           @updatedAt @db.Timestamp(6)
  tenant     Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  musicas    Artistas_Musicas[]

  @@unique([tenant_id, nome], map: "artistas_tenant_nome_unico")
  @@index([tenant_id])
  @@map("artistas")
}

model Artistas_Musicas {
  id                               String   @id @default(uuid()) @db.Uuid
  artista_id                       String   @db.Uuid
  musica_id                        String   @db.Uuid
  tenant_id                        String   @db.Uuid
  bpm                              Int?
  cifras                           String?
  lyrics                           String?
  link_versao                      String?
  created_at                       DateTime @default(now()) @db.Timestamp(6)
  updated_at                       DateTime @updatedAt @db.Timestamp(6)
  tenant                           Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  artistas_musicas_artista_id_fkey Artistas @relation(fields: [artista_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  artistas_musicas_musica_id_fkey  Musicas  @relation(fields: [musica_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, artista_id, musica_id])
  @@index([tenant_id])
  @@map("artistas_musicas")
}

model Eventos {
  id                          String                @id @default(uuid()) @db.Uuid
  data                        DateTime              @db.Timestamptz
  fk_tipo_evento              String                @db.Uuid
  descricao                   String
  tenant_id                   String                @db.Uuid
  created_at                  DateTime              @default(now()) @db.Timestamp(6)
  updated_at                  DateTime              @updatedAt @db.Timestamp(6)
  tenant                      Tenant                @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  eventos_fk_tipo_evento_fkey Tipos_Eventos         @relation(fields: [fk_tipo_evento], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Eventos_Musicas             Eventos_Musicas[]
  Eventos_Users               Eventos_Users[]

  @@index([tenant_id])
  @@map("eventos")
}

model Eventos_Musicas {
  id                              String   @id @default(uuid()) @db.Uuid
  evento_id                       String   @db.Uuid
  musicas_id                      String   @db.Uuid
  tenant_id                       String   @db.Uuid
  ordem                           Int      @default(0)
  created_at                      DateTime @default(now()) @db.Timestamp(6)
  updated_at                      DateTime @updatedAt @db.Timestamp(6)
  tenant                          Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  eventos_musicas_evento_id_fkey  Eventos  @relation(fields: [evento_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  eventos_musicas_musicas_id_fkey Musicas  @relation(fields: [musicas_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, evento_id, musicas_id])
  @@index([tenant_id])
  @@index([evento_id, ordem])
  @@map("eventos_musicas")
}

model Funcoes {
  id                    String                  @id @default(uuid()) @db.Uuid
  nome                  String
  tenant_id             String                  @db.Uuid
  created_at            DateTime                @default(now()) @db.Timestamp(6)
  updated_at            DateTime                @updatedAt @db.Timestamp(6)
  tenant                Tenant                  @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Musicas_Funcoes       Musicas_Funcoes[]
  Users_Funcoes         Users_Funcoes[]
  Eventos_Users_Funcoes Eventos_Users_Funcoes[]

  @@unique([tenant_id, nome], map: "funcoes_tenant_nome_unico")
  @@index([tenant_id])
  @@map("funcoes")
}

model Musicas {
  id                         String             @id @default(uuid()) @db.Uuid
  nome                       String
  fk_tonalidade              String?            @db.Uuid
  tenant_id                  String             @db.Uuid
  created_at                 DateTime           @default(now()) @db.Timestamp(6)
  updated_at                 DateTime           @updatedAt @db.Timestamp(6)
  tenant                     Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Artistas_Musicas           Artistas_Musicas[]
  Eventos_Musicas            Eventos_Musicas[]
  musicas_fk_tonalidade_fkey Tonalidades?       @relation(fields: [fk_tonalidade], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Musicas_Funcoes            Musicas_Funcoes[]
  Musicas_Categorias         Musicas_Categorias[]

  @@index([tenant_id])
  @@map("musicas")
}

model Musicas_Funcoes {
  id                             String   @id @default(uuid()) @db.Uuid
  musica_id                      String   @db.Uuid
  funcao_id                      String   @db.Uuid
  tenant_id                      String   @db.Uuid
  created_at                     DateTime @default(now()) @db.Timestamp(6)
  updated_at                     DateTime @updatedAt @db.Timestamp(6)
  tenant                         Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  musicas_funcoes_funcao_id_fkey Funcoes  @relation(fields: [funcao_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  musicas_funcoes_musica_id_fkey Musicas  @relation(fields: [musica_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, musica_id, funcao_id])
  @@index([tenant_id])
  @@map("musicas_funcoes")
}

model Categorias {
  id                 String               @id @default(uuid()) @db.Uuid
  nome               String
  tenant_id          String               @db.Uuid
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @updatedAt @db.Timestamp(6)
  tenant             Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Musicas_Categorias Musicas_Categorias[]

  @@unique([tenant_id, nome], map: "categorias_tenant_nome_unico")
  @@index([tenant_id])
  @@map("categorias")
}

model Musicas_Categorias {
  id                                    String     @id @default(uuid()) @db.Uuid
  musica_id                             String     @db.Uuid
  categoria_id                          String     @db.Uuid
  tenant_id                             String     @db.Uuid
  created_at                            DateTime   @default(now()) @db.Timestamp(6)
  updated_at                            DateTime   @updatedAt @db.Timestamp(6)
  tenant                                Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  musicas_categorias_musica_id_fkey     Musicas    @relation(fields: [musica_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  musicas_categorias_categoria_id_fkey  Categorias @relation(fields: [categoria_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, musica_id, categoria_id])
  @@index([tenant_id])
  @@map("musicas_categorias")
}

model Eventos_Users {
  id                            String                  @id @default(uuid()) @db.Uuid
  evento_id                     String                  @db.Uuid
  fk_user_id                    String                  @map("fk_user_id") @db.Uuid
  tenant_id                     String                  @db.Uuid
  created_at                    DateTime                @default(now()) @db.Timestamp(6)
  updated_at                    DateTime                @updatedAt @db.Timestamp(6)
  tenant                        Tenant                  @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  eventos_users_evento_id_fkey  Eventos                 @relation(fields: [evento_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  eventos_users_fk_user_id_fkey Users                   @relation(fields: [fk_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Eventos_Users_Funcoes         Eventos_Users_Funcoes[]

  @@unique([tenant_id, evento_id, fk_user_id])
  @@index([tenant_id])
  @@map("eventos_users")
}

model Eventos_Users_Funcoes {
  id                                     String        @id @default(uuid()) @db.Uuid
  evento_user_id                         String        @db.Uuid
  funcao_id                              String        @db.Uuid
  tenant_id                              String        @db.Uuid
  created_at                             DateTime      @default(now()) @db.Timestamp(6)
  updated_at                             DateTime      @updatedAt @db.Timestamp(6)
  tenant                                 Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  eventos_users_funcoes_evento_user_fkey Eventos_Users @relation(fields: [evento_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  eventos_users_funcoes_funcao_fkey      Funcoes       @relation(fields: [funcao_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, evento_user_id, funcao_id])
  @@index([tenant_id])
  @@map("eventos_users_funcoes")
}

model Users_Funcoes {
  id                              String   @id @default(uuid()) @db.Uuid
  fk_user_id                      String   @map("fk_user_id") @db.Uuid
  funcao_id                       String   @db.Uuid
  tenant_id                       String   @db.Uuid
  created_at                      DateTime @default(now()) @db.Timestamp(6)
  updated_at                      DateTime @updatedAt @db.Timestamp(6)
  tenant                          Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users_funcoes_funcao_id_fkey    Funcoes  @relation(fields: [funcao_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_funcoes_fk_user_id_fkey   Users    @relation(fields: [fk_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, fk_user_id, funcao_id])
  @@index([tenant_id])
  @@map("users_funcoes")
}

model Tipos_Eventos {
  id         String    @id @default(uuid()) @db.Uuid
  nome       String
  tenant_id  String    @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @updatedAt @db.Timestamp(6)
  tenant     Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Eventos    Eventos[]

  @@unique([tenant_id, nome], map: "tipos_eventos_tenant_nome_unico")
  @@index([tenant_id])
  @@map("tipos_eventos")
}

model Tonalidades {
  id         String    @id @default(uuid()) @db.Uuid
  tom        String
  tenant_id  String    @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @updatedAt @db.Timestamp(6)
  tenant     Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Musicas    Musicas[]

  @@unique([tenant_id, tom], map: "tonalidades_tenant_tom_unico")
  @@index([tenant_id])
  @@map("tonalidades")
}

// ─── Auth, Session & RBAC ───────────────────────────────────────────

model Users {
  id              String               @id @default(uuid()) @db.Uuid
  name            String               @db.VarChar(255)
  email           String               @unique @db.VarChar(255)
  password        String               @db.VarChar(255)
  avatar          String?              @db.VarChar(255)
  telefone        String?              @db.VarChar(20)
  created_at      DateTime             @default(now()) @db.Timestamp(6)
  updated_at      DateTime             @updatedAt @db.Timestamp(6)
  tenant_users    TenantUsers[]
  roles           UsersRoles[]
  permissions     UsersPermissions[]
  refresh_tokens  UsersRefreshTokens[]
  recovery_tokens UsersRecoveryTokens[]
  Eventos_Users   Eventos_Users[]
  Users_Funcoes   Users_Funcoes[]

  @@map("users")
}

model Roles {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @unique @db.VarChar(255)
  description String             @db.VarChar(500)
  created_at  DateTime           @default(now()) @db.Timestamp(6)
  updated_at  DateTime           @updatedAt @db.Timestamp(6)
  users       UsersRoles[]
  permissions PermissionsRoles[]

  @@map("roles")
}

model Permissions {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @unique @db.VarChar(255)
  description String             @db.VarChar(500)
  created_at  DateTime           @default(now()) @db.Timestamp(6)
  updated_at  DateTime           @updatedAt @db.Timestamp(6)
  roles       PermissionsRoles[]
  users       UsersPermissions[]

  @@map("permissions")
}

model UsersRefreshTokens {
  id            String   @id @default(uuid()) @db.Uuid
  refresh_token String   @db.VarChar(500)
  user_id       String   @db.Uuid
  expires_date  DateTime @db.Timestamp(6)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)
  user          Users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
  @@index([user_id, refresh_token])
  @@map("users_refresh_tokens")
}

model UsersRecoveryTokens {
  id         String   @id @default(uuid()) @db.Uuid
  token      String   @unique @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
  user       Users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token])
  @@map("users_recovery_tokens")
}

/// Atribuição de role a usuário, escopada por tenant.
model UsersRoles {
  user_id   String @db.Uuid
  role_id   String @db.Uuid
  tenant_id String @db.Uuid
  user      Users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role      Roles  @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant    Tenant @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([user_id, role_id, tenant_id])
  @@index([tenant_id])
  @@map("users_roles")
}

/// Atribuição de permissão direta a usuário, escopada por tenant.
model UsersPermissions {
  user_id       String      @db.Uuid
  permission_id String      @db.Uuid
  tenant_id     String      @db.Uuid
  user          Users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission    Permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant        Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([user_id, permission_id, tenant_id])
  @@index([tenant_id])
  @@map("users_permissions")
}

model PermissionsRoles {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  role          Roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission    Permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
  @@map("permissions_roles")
}
